{
  "name": "@dicebear/api",
  "private": true,
  "license": "MIT",
  "author": "Florian Körner <contact@florian-koerner.com>",
  "type": "module",
  "scripts": {
    "predev": "tsx ./scripts/build-fonts.ts && tsx ./scripts/build-blocklist.ts",
    "dev": "tsx --watch ./src/server.ts",
    "prebuild": "tsx ./scripts/build-fonts.ts && tsx ./scripts/build-blocklist.ts",
    "build": "tsc --build",
    "start": "node ./dist/server.js",
    "test": "node --test tests/*.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dicebear/converter": "^10.6.0",
    "@dicebear/core": "^10.6.0",
    "@dicebear/styles-10": "npm:@dicebear/styles@^10.6.0-rc.2",
    "@dicebear/schema": "^1.3.0",
    "@fastify/cors": "^11.2.0",
    "fast-xml-parser": "^5.7.3",
    "fastify": "^5.8.2",
    "qs": "^6.15.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@tsconfig/node22": "^22.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "@types/qs": "^6.15.0",
    "@woff2/woff2-rs": "^1.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
