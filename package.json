{
  "name": "@dicebear/api",
  "private": true,
  "license": "MIT",
  "author": "Florian Körner <contact@florian-koerner.com>",
  "type": "module",
  "scripts": {
    "predev": "tsx ./scripts/build-fonts.ts && tsx ./scripts/build-blocklist.ts",
    "dev": "tsx --watch ./src/server.ts",
    "prebuild": "tsx ./scripts/build-fonts.ts && tsx ./scripts/build-blocklist.ts",
    "build": "tsc --build",
    "start": "node ./dist/server.js",
    "test": "node --test tests/*.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dicebear/converter": "^10.7.0",
    "@dicebear/core": "^11.0.0-rc.1",
    "@dicebear/styles-10": "npm:@dicebear/styles@^10.6.0",
    "@dicebear/styles-11": "npm:@dicebear/styles@^11.0.0-rc.2",
    "@dicebear/schema": "^2.0.1",
    "@fastify/cors": "^11.3.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.1",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.4.1",
    "@types/qs": "^6.15.1",
    "@woff2/woff2-rs": "^1.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
