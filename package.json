{
  "name": "@dicebear/api",
  "private": true,
  "license": "MIT",
  "author": "Florian Körner <contact@florian-koerner.com>",
  "type": "module",
  "scripts": {
    "predev": "tsx ./scripts/build-fonts.ts",
    "dev": "tsx --watch ./src/server.ts",
    "prebuild": "tsx ./scripts/build-fonts.ts",
    "build": "tsc --build",
    "start": "node ./dist/server.js",
    "test": "node --test tests/*.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write ."
  },
  "workspaces": [
    "./versions/*"
  ],
  "dependencies": {
    "@dicebear/api-5": "*",
    "@dicebear/api-6": "*",
    "@dicebear/api-7": "*",
    "@dicebear/api-8": "*",
    "@dicebear/api-9": "*",
    "@dicebear/converter": "^9.4.2",
    "@fastify/cors": "^11.2.0",
    "change-case": "^5.4.4",
    "fastify": "^5.8.2",
    "qs": "^6.15.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@tsconfig/node20": "^20.1.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "@types/qs": "^6.15.0",
    "@woff2/woff2-rs": "^1.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
